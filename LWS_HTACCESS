# ============================================================
# MAASH — .htaccess pour Apache (version simplifiée)
# ============================================================
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^index\.html$ - [L]

# Dépannage : aucun réglage optionnel de cache, CORS ou compression.
# Rewrite rules pour Vue Router (SPA)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
</IfModule>

# Type MIME de l'application Android (directive de base, sans module requis)
AddType application/vnd.android.package-archive .apk
